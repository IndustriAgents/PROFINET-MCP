# Example settings for profinet-mcp. Copy to .env (in the directory you start the server
# from, or a parent) or pass a file explicitly with `profinet-mcp --env-file PATH`.
# Values already set in the real environment always win.

# Backend: none (default, contacts nothing) | mock | network
PROFINET_BACKEND=mock

# mock backend: where profinet-mock-server listens
PROFINET_MOCK_HOST=127.0.0.1
PROFINET_MOCK_PORT=5600

# network backend: Ethernet interface on the PROFINET network (DCP discovery needs
# raw-socket privileges on it)
# PROFINET_INTERFACE=eth0

# Timing
# PROFINET_DCP_TIMEOUT=5             # default discovery time in seconds (0.5-60)
# PROFINET_TIMEOUT=10                # per request to the mock, in seconds
# PROFINET_MAX_RETRIES=3             # extra connection attempts (reads may also be re-sent)
# PROFINET_RETRY_BACKOFF_BASE=0.5

# Aliases and GSDML files
# DEVICE_MAP_FILE=devices.json
# PROFINET_GSD_PATH=gsdml/

# --- Safety switches -------------------------------------------------------------------
# These are honoured ONLY from the real process environment or a file given with --env-file.
# In a .env that the server finds by itself they are ignored, with a warning on stderr:
# when an MCP client starts the server, the working directory is the client's project,
# which may not be trusted to turn writes on.
#
# PROFINET_WRITES_ENABLED=false       # true allows write_io_data / write_device_by_alias
# PROFINET_CONFIG_CMDS_ENABLED=false  # set_device_name, set_device_ip, identify_device
#                                     # (they also need PROFINET_WRITES_ENABLED=true)
