# Example settings for profinet-mcp.
#
# Where settings come from:
#   1. the real environment (e.g. the MCP client's "env" block) - always wins;
#   2. a file passed explicitly with `profinet-mcp --env-file PATH`;
#   3. otherwise profinet-python/.env of a source checkout (copy this file there).
# A .env in the working directory or any parent is NEVER read: when an MCP client
# launches the server, that directory is the client's project, which may not be trusted.
# An installed package reads no implicit .env at all.
#
# profinet-python/.env may set only PROFINET_* settings and DEVICE_MAP_FILE (keys are
# case-insensitive). Anything else, and every safety switch, is ignored with a warning.

# Backend: none (default, contacts nothing) | mock | network | cifx
PROFINET_BACKEND=mock

# mock backend: where profinet-mock-server listens
PROFINET_MOCK_HOST=127.0.0.1
PROFINET_MOCK_PORT=5600

# network backend: Ethernet interface on the PROFINET network (DCP discovery needs
# raw-socket privileges on it)
# PROFINET_INTERFACE=eth0

# Timing
# PROFINET_DCP_TIMEOUT=5             # default discovery time in seconds (0.5-60)
# PROFINET_TIMEOUT=5                 # per connect / reply to the mock, in seconds
# PROFINET_MAX_RETRIES=3             # extra connection attempts (reads may also be re-sent)
# PROFINET_RETRY_BACKOFF_BASE=0.5

# Aliases and GSDML files
# DEVICE_MAP_FILE=devices.json
# PROFINET_GSD_PATH=gsdml/

# --- Safety switches -------------------------------------------------------------------
# Honoured ONLY from the real process environment or a file given with --env-file.
# In profinet-python/.env they are ignored, with a warning on stderr.
#
# PROFINET_WRITES_ENABLED=false       # true allows write_io_data / write_device_by_alias
# PROFINET_CONFIG_CMDS_ENABLED=false  # set_device_name, set_device_ip, identify_device
#                                     # (they also need PROFINET_WRITES_ENABLED=true)

# cifx backend: precommissioned Linux UIO card in donttouch startup mode only.
# See docs/cifx-controller.md. Example map values MUST be replaced from engineering.
# PROFINET_CIFX_LIBRARY=/usr/local/lib/libcifx.so
# PROFINET_CIFX_MAP_FILE=/etc/profinet/commissioned-image.json
# PROFINET_CIFX_BASE_DIR=/var/lib/profinet/empty-cifx-config
# PROFINET_CIFX_CARD_NUMBER=0
# PROFINET_CIFX_CHANNEL=0
# PROFINET_CIFX_INIT_ENABLED=false  # explicit env/--env-file only; implicit .env cannot enable
