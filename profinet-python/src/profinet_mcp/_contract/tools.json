        "openWorldHint": false
      }
    },
    {
      "name": "get_connection_status",
      "description": "Connection settings plus a reachability check of the backend.\n\n        Mock backend: opens and closes a TCP connection to the mock (reachable true/false). Network\n        backend: not checked (reachable null) - run discover_devices instead. No backend: reachable null.\n        ",
      "inputSchema": {
        "properties": {},
        "title": "get_connection_statusArguments",
        "type": "object",
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "success",
          "data",
          "error",
          "meta"
        ],
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {},
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "meta": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": true
      }
    }
  ],
